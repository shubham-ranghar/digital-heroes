# Draw engine (all money in INR)
# Per-subscriber draw fund contribution in whole rupees (INR, not paise).
# ₹250 of the ₹499 monthly fee; pool = active subscribers × this × percentage.
DRAW_FEE_PER_SUBSCRIBER_INR=250
# Share of that fund paid out as prizes, 0-100.
DRAW_PRIZE_POOL_PERCENTAGE=100

# Marketing / UI
NEXT_PUBLIC_SUBSCRIPTION_FEE_INR=499
NEXT_PUBLIC_SUBSCRIPTION_FEE_INR_YEARLY=

# Footer & contact
# Use a domain inbox (e.g. support@yourdomain.in). Free webmail addresses
# (gmail, outlook, ...) are hidden; the footer links to /contact instead.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
